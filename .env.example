DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

RADARR_URL=http://localhost:7878
RADARR_API_KEY=
# Set these if Radarr has multiple root folders or quality profiles.
# RADARR_ROOT_FOLDER=
# RADARR_QUALITY_PROFILE_ID=

SONARR_URL=http://localhost:8989
SONARR_API_KEY=
# Optional: show active downloads and stalled torrents from qBittorrent.
# QBITTORRENT_URL=http://localhost:8080
# QBITTORRENT_USERNAME=
# QBITTORRENT_PASSWORD=
# Optional Discord channel for download-complete alerts.
# ALERT_CHANNEL_ID=
# Optional: restrict /request to comma-separated Discord channel IDs.
# REQUEST_ALLOWED_CHANNEL_IDS=
# Optional: maximum active requests per Discord user. Unset means no limit.
# REQUEST_MAX_ACTIVE_PER_USER=
# Set the TV and anime values separately if Sonarr has multiple options.
# SONARR_TV_ROOT_FOLDER=
# SONARR_TV_QUALITY_PROFILE_ID=
# SONARR_ANIME_ROOT_FOLDER=
# SONARR_ANIME_QUALITY_PROFILE_ID=
# Optional shared Sonarr fallbacks when the TV/anime values are omitted.
# SONARR_ROOT_FOLDER=
# SONARR_QUALITY_PROFILE_ID=
