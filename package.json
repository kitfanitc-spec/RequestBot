{
  "name": "request2.0",
  "version": "1.0.0",
  "description": "Cross-platform desktop dashboard and Discord media-request bot for Radarr, Sonarr, and qBittorrent.",
  "main": "desktop.js",
  "scripts": {
    "start": "node restart.js",
    "desktop": "electron desktop.js",
    "deploy": "node deploy.js",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:linux": "electron-builder --linux AppImage deb",
    "test": "node --test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.5",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.requestbot.downloads",
    "productName": "Request Bot",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!**/.env",
      "!request-history.sqlite",
      "!test/**",
      "!dist/**",
      "!dist-*/**",
      "!node_modules/.cache/**"
    ],
    "extraMetadata": {
      "main": "desktop.js"
    },
    "win": {
      "icon": "build\\request-bot.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "icon": "build/request-bot.icns",
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/request-bot.png",
      "category": "Utility",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
